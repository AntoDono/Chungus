{
  "name": "chungus",
  "version": "1.0.0",
  "private": true,
  "description": "CHUNGUS gateway — spawn Django, proxy APIs, serve the Nuxt frontend",
  "main": "server.js",
  "scripts": {
    "postinstall": "bun install --cwd frontend",
    "build": "bun run --cwd frontend generate",
    "start": "node server.js",
    "dev": "NUXT_DEV=1 node server.js",
    "frontend:dev": "bun run --cwd frontend dev",
    "frontend:generate": "bun run --cwd frontend generate"
  },
  "license": "ISC",
  "dependencies": {
    "http-proxy": "^1.18.1"
  }
}
