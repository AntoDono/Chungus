{
  "name": "chungus",
  "version": "1.0.0",
  "private": true,
  "description": "CHUNGUS gateway — spawn Django, proxy APIs, serve the Nuxt frontend",
  "main": "server.js",
  "scripts": {
    "postinstall": "npm install --prefix frontend",
    "build": "npm run generate --prefix frontend",
    "start": "node server.js",
    "dev": "NUXT_DEV=1 node server.js",
    "frontend:dev": "npm run dev --prefix frontend",
    "frontend:generate": "npm run generate --prefix frontend"
  },
  "license": "ISC",
  "dependencies": {
    "http-proxy": "^1.18.1"
  }
}
