# CHUNGUS Django backend
# Copy to backend/.env — loaded by Chungus/settings.py via python-dotenv.

# --- Django core ---
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# --- HuggingFace (vLLM gated models) ---
# Used when a Model row has no huggingface_token. vLLM reads HF_TOKEN automatically.
HF_TOKEN=
HUGGINGFACE_TOKEN=

# --- GPU / CUDA (vLLM) ---
# Which GPU(s) vLLM may use. Empty = all visible devices.
CUDA_VISIBLE_DEVICES=0

# vLLM / PyTorch cache locations (optional)
# HF_HOME=~/.cache/huggingface
# TRANSFORMERS_CACHE=~/.cache/huggingface/hub
# TORCH_HOME=~/.cache/torch

# --- vLLM runtime (optional; passed to the vLLM worker process) ---
# Logging
# VLLM_LOGGING_LEVEL=INFO

# Attention backend (e.g. FLASH_ATTN, FLASHINFER — depends on install)
# VLLM_ATTENTION_BACKEND=FLASH_ATTN

# Worker multiprocessing (use spawn if you hit CUDA re-init errors)
# VLLM_WORKER_MULTIPROC_METHOD=spawn

# Disable multiprocessing for debugging
# VLLM_ENABLE_V1_MULTIPROCESSING=0

# Max sequence length override (per-model max_context_length in dashboard usually wins at init)
# VLLM_MAX_MODEL_LEN=

# GPU memory fraction (0.0–1.0) — vLLM also accepts via LLM(gpu_memory_utilization=...) if wired in code
# VLLM_GPU_MEMORY_UTILIZATION=0.90

# Tensor parallel size (multi-GPU)
# VLLM_TENSOR_PARALLEL_SIZE=1

# --- Ollama ---
# Default when a Model row has empty ollama_base_url (dashboard per-model override).
OLLAMA_HOST=http://localhost:11434

# Ollama client env (if running Ollama on another host)
# OLLAMA_ORIGINS=*

# --- Model defaults (dashboard / DB) ---
# Sampling and context are stored per Model in the database, not only here:
#   provider: vllm | ollama
#   model_type: chat | embedding
#   model_path: HuggingFace id or Ollama model name
#   max_context_length, default_temperature, default_max_tokens,
#   default_top_p, default_top_k, default_min_p,
#   default_presence_penalty, default_repetition_penalty,
#   thinking_mode (Ollama: default | low | medium | high | enabled | disabled)
#   alwayswarm, is_default, huggingface_token, ollama_base_url

# Example vLLM chat model paths:
#   meta-llama/Llama-3.2-3B-Instruct
#   Qwen/Qwen2.5-7B-Instruct
# Example vLLM embedding:
#   intfloat/e5-mistral-7b-instruct
# Example Ollama models:
#   llama3.2, qwen2.5, nomic-embed-text, gpt-oss
