# CHUNGUS gateway (server.js)
# Copy to .env at repo root, or export before `npm start` / `npm run dev`.
# The gateway forwards these to the Django child process.

# Public URL port (browser hits this)
PORT=3567

# Django bind (internal — not exposed unless you change routing)
DJANGO_HOST=127.0.0.1
DJANGO_PORT=8000

# Wait for GET /internal/health before accepting traffic (ms)
DJANGO_HEALTH_TIMEOUT_MS=60000

# Dev: proxy page requests to Nuxt HMR (set by npm run dev)
# NUXT_DEV=1
NUXT_PORT=3001

# Django process: backend/venv/bin/python (default if venv exists) | USE_VENV=0 for global poetry
# USE_VENV=0
# NODE_ENV=production
# DJANGO_SERVER=gunicorn
# DJANGO_CMD=custom shell command to start Django

# Optional: set HF_TOKEN, CUDA_VISIBLE_DEVICES, etc. in backend/.env or here.
