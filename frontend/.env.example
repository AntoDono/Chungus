# CHUNGUS Nuxt frontend
# Copy to frontend/.env for local overrides.
# Static build talks to same-origin /internal and /v1 via the gateway — no API base URL needed in production.

# Nuxt dev server (must match gateway NUXT_PORT when using npm run dev at repo root)
NUXT_PORT=3001
# NITRO_PORT=3001

# Optional public runtime (only if you add runtimeConfig in nuxt.config.ts)
# NUXT_PUBLIC_APP_NAME=CHUNGUS

# Color mode default (overrides nuxt.config preference if wired)
# NUXT_COLOR_MODE_PREFERENCE=light
